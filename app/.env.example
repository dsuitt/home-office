# Copy to .env and fill in. Never commit .env.

# Long random string. Encrypts bank tokens at rest and signs the sign-in cookie.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Who can sign in: name:password pairs, comma separated. Leave empty only on your own machine.
APP_USERS=dan:change-me,wife:change-me-too

# Plaid keys from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake banks) or production (real banks, incl. the free Trial plan)
PLAID_ENV=sandbox

# Where the database file lives
MONEY_DB=data/money.db

# Set to 1 to start with a made-up sample household (cleared from Settings)
DEMO=0
